{
    "name": "express-api-template",
    "version": "1.0.0",
    "description": "A scalable Express API template",
    "main": "dist/config/app.js",
    "scripts": {
        "start": "node dist/config/app.js",
        "dev": "nodemon src/config/app.ts",
        "build": "tsc",
        "lint": "eslint src/**/*.ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv-safe": "^8.2.0",
        "express": "^4.19.2",
        "helmet": "^7.1.0",
        "http-status-codes": "^2.3.0",
        "winston": "^3.13.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/dotenv-safe": "^8.1.5",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.7",
        "eslint": "^9.0.0",
        "nodemon": "^3.1.0",
        "prettier": "^3.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5"
    }
}